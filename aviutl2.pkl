// 設定ファイルについては https://github.com/sevenc-nanashi/aviutl2-cli を参照してください。
amends "https://raw.githubusercontent.com/sevenc-nanashi/aviutl2-cli/refs/tags/0.11.2/src/AviUtl2CliConfig.pkl"

project {
  id = "Book-0225.EAP2"
  name = "External_Audio_Processing2"
  version = "0.0.40"
}

build_group {
  ["debug_group"] = "cmake --build ./build --config Debug --target aviutl2_External_Audio_Processing"
  ["release_group"] = "cmake --build ./build --config Release --target aviutl2_External_Audio_Processing"
}

artifacts {
  ["English_External_Audio_Processing2_aul2"] {
    source = "lang/English.External_Audio_Processing2.aul2"
    enabled = true
    destination = "Language/English.External_Audio_Processing2.aul2"
  }

  ["Default_External_Audio_Processing2_aul2"] {
    source = "lang/Default.External_Audio_Processing2.aul2"
    enabled = true
    destination = "Language/Default.External_Audio_Processing2.aul2"
  }

  ["External_Audio_Processing2_aux2"] {
    source = "build/bin/External_Audio_Processing2.aux2"
    enabled = true
    destination = "Plugin/External_Audio_Processing2.aux2"

    profiles {
      ["debug"] {
        build = new BuildGroupRef { group = "debug_group" }
      }
      ["release"] {
        build = new BuildGroupRef { group = "release_group" }
      }
    }
  }
}

development {
  aviutl2_version = "latest"
}

preview {
  aviutl2_version = "latest"
}

release {
  output_dir = "release"
  package_template = "package.txt"
  zip_name = "{name}"
  profile = "release"
  package_name = "External Audio Processing 2"
  package_information = "External Audio Processing 2 v{version} by BOOK25"
}